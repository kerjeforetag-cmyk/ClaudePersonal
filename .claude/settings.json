{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.sh\"",
            "statusMessage": "Installing test dependencies (npm install)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/remind-deliver-html.sh\"",
            "timeout": 10,
            "statusMessage": "Checking if the presentation needs delivering"
          }
        ]
      }
    ]
  }
}
